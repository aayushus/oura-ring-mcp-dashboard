# =============================================================================
# Oura MCP Server & Health Dashboard — Environment Configuration
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# NOTE: You do NOT need to put your Oura Personal Access Token here!
# Oura accounts are connected securely per-user inside the Web Dashboard.
# =============================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000

# Database Persistence (PostgreSQL or local SQLite fallback)
# Docker Compose uses the service name "db"
DATABASE_URL=postgresql://postgres:postgres@db:5432/oura_health

# Security & Session Authentication
# Set a strong random secret (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_here

# -----------------------------------------------------------------------------
# OPTIONAL: Global Oura Developer App Credentials
# (Can also be configured directly in the Web UI under Settings -> Administration)
# -----------------------------------------------------------------------------
# If you want to enable OAuth2 login for multiple users:
# 1. Create an app at https://cloud.ouraring.com/oauth/applications
# 2. Set Redirect URI to: http://localhost:3000/api/auth/oura/callback
# -----------------------------------------------------------------------------
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# OPTIONAL: Morning Email Digest (SMTP)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
