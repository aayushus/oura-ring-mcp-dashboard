{
  "name": "oura-ring-mcp",
  "version": "0.1.4",
  "mcpName": "io.github.mitchhankins01/oura-ring-mcp",
  "description": "MCP server for Oura Ring data with smart analysis tools",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ],
    "overrides": {
      "@hono/node-server": ">=1.19.15",
      "@tootallnate/once": ">=2.0.1",
      "brace-expansion": ">=2.1.4",
      "fast-uri": ">=3.1.5",
      "flatted": ">=3.3.2",
      "hono": ">=4.12.34",
      "ip-address": ">=10.3.1",
      "minimatch": ">=9.0.5",
      "nanoid": ">=3.3.18",
      "path-to-regexp": ">=8.2.0",
      "postcss": ">=8.5.23",
      "qs": ">=6.13.0",
      "rollup": ">=4.22.4",
      "shell-quote": ">=1.8.5",
      "tar": ">=7.5.21",
      "uuid": ">=11.1.1",
      "ws": ">=8.17.1"
    }
  },
  "overrides": {
    "@hono/node-server": ">=1.19.15",
    "@tootallnate/once": ">=2.0.1",
    "brace-expansion": ">=2.1.4",
    "fast-uri": ">=3.1.5",
    "flatted": ">=3.3.2",
    "hono": ">=4.12.34",
    "ip-address": ">=10.3.1",
    "minimatch": ">=9.0.5",
    "nanoid": ">=3.3.18",
    "path-to-regexp": ">=8.2.0",
    "postcss": ">=8.5.23",
    "qs": ">=6.13.0",
    "rollup": ">=4.22.4",
    "shell-quote": ">=1.8.5",
    "tar": ">=7.5.21",
    "uuid": ">=11.1.1",
    "ws": ">=8.17.1"
  },
  "main": "dist/index.js",
  "bin": {
    "oura-ring-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitchhankins01/oura-ring-mcp.git"
  },
  "homepage": "https://github.com/mitchhankins01/oura-ring-mcp#readme",
  "bugs": {
    "url": "https://github.com/mitchhankins01/oura-ring-mcp/issues"
  },
  "scripts": {
    "build": "npm --prefix dashboard run build && tsc",
    "dev": "tsc --watch",
    "dev:inspect": "concurrently -n tsc,mcp -c blue,green \"pnpm dev\" \"pnpm inspect\"",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "inspect": "mcp-inspector node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "update-openapi": "bash scripts/update-openapi-spec.sh",
    "generate-types": "npx openapi-typescript oura-openapi.json -o src/types/oura-api.ts",
    "update-types": "pnpm update-openapi && pnpm generate-types",
    "prepare": "husky"
  },
  "keywords": [
    "mcp",
    "oura",
    "oura-ring",
    "health",
    "sleep",
    "claude",
    "ai"
  ],
  "author": "Mitch Hankins",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@node-rs/argon2": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "sqlite": "5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.19.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "js-yaml": "^4.3.1",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
